{
  "name": "battletech-rpg-helper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "pretest:e2e:pwa": "npm run build",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:db": "supabase test db && npm run test:db:concurrency",
    "test:db:concurrency": "vitest run --config vitest.db.config.ts",
    "rules:ingest": "tsx scripts/convert-dat.ts",
    "traits:ingest": "tsx scripts/parse-rulebook-traits.ts",
    "skills:ingest": "tsx scripts/parse-rulebook-skills.ts",
    "equipment:ingest": "tsx scripts/parse-rulebook-equipment.ts",
    "rules:extract": "tsx scripts/extract-rules.ts",
    "supabase:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "supabase:start": "supabase stop --all && supabase start",
    "seed:generate": "tsx scripts/generate-seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@serwist/next": "^9.5.13",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^25.0.1",
    "pg": "^8.23.1",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "serwist": "^9.5.13",
    "supabase": "^2.121.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
