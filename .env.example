# Supabase connection — copy to .env.local and fill in.
#
# Copying and filling this template is sufficient. These names carry the
# BT_CHARGEN_ prefix that the Vercel Supabase integration provisions.
# For an already-linked Vercel project, `vercel env pull .env.local` is an optional
# alternative; do not overwrite an existing .env.local with credentials to keep.

# Project URL. Note: no NEXT_PUBLIC_ prefix — next.config.ts bridges it into the
# client bundle via its `env` key, so keep the two in sync if this is renamed.
BT_CHARGEN_SUPABASE_URL=

# Public by design; RLS is what protects data.
NEXT_PUBLIC_BT_CHARGEN_SUPABASE_ANON_KEY=

# Optional server-only secret; ordinary app development does not require it.
# Leave blank. Never prefix with NEXT_PUBLIC_ or add to Next's env mapping.
BT_CHARGEN_SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase DB password (used by `supabase` CLI for local dev).
DB_PASS=
